---
const links = [
  { href: '/', label: 'Home' },
  { href: '/shows', label: 'Shows' },
  { href: '/booking', label: 'Booking' },
  { href: '/software', label: 'Software' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---
<header class="site-header">
  <a class="wordmark logo" href="/"><img src="/logo.png" alt="Panic Signals" width="64" height="64" /></a>
  <nav aria-label="Main">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
