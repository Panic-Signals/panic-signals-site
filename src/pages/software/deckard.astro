---
import { getEntry, render } from 'astro:content';
import SoftwareLayout from '../../layouts/SoftwareLayout.astro';

const entry = await getEntry('software', 'deckard');
if (!entry) throw new Error('src/content/software/deckard.md is missing');
const { Content } = await render(entry);
const { title, summary, repo, status } = entry.data;
---
<SoftwareLayout title={title} description={summary}>
  <span class="eyebrow">Software // Groovebox</span>
  <h1 class="wordmark">{title}</h1>
  <p class="lede">{summary}</p>
  <div class="actions">
    <a class="button primary" href={`${repo}/releases`}>Download</a>
    <a class="button" href="/software/deckard/manual">Read the manual</a>
    <a class="button" href={repo}>Source on GitHub</a>
  </div>
  <Content />
  <div class="notice">
    <strong>{status}.</strong> The <a href="/software/deckard/manual">DECKARD manual</a>
    covers what DECKARD adds to Maschine and how it differs.
    <a href={`${repo}/releases`}>The releases page</a> has the release notes.
  </div>
</SoftwareLayout>
